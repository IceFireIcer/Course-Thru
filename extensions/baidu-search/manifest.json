{
  "manifest_version": 3,
  "name": "百度（Course-Thru 内置）",
  "version": "1.1.0",
  "description": "默认搜索引擎设为百度；新标签页直接打开百度，全程无确认框",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"],
  "host_permissions": ["https://www.baidu.com/"],
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "百度",
      "keyword": "baidu.com",
      "search_url": "https://www.baidu.com/s?wd={searchTerms}",
      "suggest_url": "https://www.baidu.com/sugrec?prod=pc&wd={searchTerms}",
      "favicon_url": "https://www.baidu.com/favicon.ico",
      "encoding": "UTF-8",
      "is_default": true
    }
  }
}
