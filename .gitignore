# ===== 构建产物（运行 build.ps1 生成）=====
/dist/
/dist-installer/
/Build-Product/

# ===== 运行时数据与启动器产物（首次启动生成，绝不能上传）=====
# dist/ 整体已忽略，这里显式列出关键项，防止未来调整 dist 忽略规则时误传
/dist/profile/
/dist/profile_seed/
/dist/first_run.flag
/dist/coursethru*.log
/dist/crash-logs/

# ===== 构建缓存（build.ps1 下载的组件：Chromium / Go / Inno Setup 等）=====
/.tools/

# ===== 环境自动生成的目录与文件（CherryStudio / Claude Code，不属于本项目代码）=====
/.claude/
/.agents/
/skills-lock.json

# ===== 技术指南/版本方案文档（本地保留，不入库）=====
# HANDOVER.md 已于 2026-08-12 入库（完整交接文档随仓库维护）
/BRANDING-PATCH.md
/CONSOLE-POLICY-NOTES.md
/LOGO-REPLACEMENT.md
/VERSION.md
/OPEN-VERSION-GUIDE.md

# ===== 密钥：私钥绝不上传。公钥 keys/*.key 需保留在仓库中以固定各扩展 ID ====
/keys/*_private.pem

# ===== 系统与编辑器杂项 =====
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
__pycache__/
*.pyc
